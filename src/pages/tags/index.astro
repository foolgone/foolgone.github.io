---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/posts';

const tags = await getTags();
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Tags</p>
      <h1>标签</h1>
      <p>共 {tags.length} 个标签。点进去看同一主题下的所有文章。</p>
    </header>

    {tags.length === 0 ? (
      <p class="empty-state">还没有标签，给文章的 frontmatter 加上 tags 即可。</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
